# Obrigatorio: aceite os termos do Minecraft antes de iniciar.
# https://www.minecraft.net/eula
EULA=FALSE

# O script de instalacao substitui estes dois valores automaticamente.
PANEL_ADMIN_TOKEN=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CONSOLE_PASSWORD=CHANGE_ME_WITH_AT_LEAST_24_RANDOM_CHARACTERS

# Servidor Bedrock
SERVER_NAME=Servidor Bedrock
LEVEL_NAME=Mundo Principal
GAMEMODE=survival
DIFFICULTY=normal
MAX_PLAYERS=10
VIEW_DISTANCE=32
TICK_DISTANCE=4
ALLOW_CHEATS=false
ALLOW_LIST=false
ALLOW_LIST_USERS=
OPS=
MINECRAFT_PORT=19132
MINECRAFT_BIND_IP=0.0.0.0
TZ=America/Bahia

# Reinicio diario para verificar e instalar a versao Bedrock mais recente.
# Use HH:MM; deixe vazio para desativar.
AUTO_UPDATE_TIME=05:00

# Painel: fica apenas no localhost; o Cloudflare Tunnel aponta para esta porta.
PANEL_PORT=8080
SESSION_HOURS=12
